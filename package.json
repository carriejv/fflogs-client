{
	"name": "fflogs-client",
	"version": "0.1.0",
	"description": "Dumps human-readable info on an FFLogs report via the GraphQL API",
	"keywords": [
		"fflogs",
		"warcraftlogs",
		"archon",
		"graphql",
		"gql",
		"typescript",
		"types"
	],
	"main": "index.js",
	"directories": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts"
	},
	"scripts": {
		"start": "npm run build && node ./dist/index.js",
		"test": "npm run lint && npm run testOnly",
		"testOnly": "nyc --reporter=html --reporter=text --reporter=lcov mocha -r ts-node/register ./test/**/*.spec.ts",
		"lint": "eslint ./src --ext .ts",
		"build": "rm -rf ./dist && tsc --project ./tsconfig.json",
		"buildEsm": "rm -rf ./dist && tsc --project ./tsconfig.json --module es6 --moduleResolution node ",
		"docs": "typedoc --out docs --theme ./node_modules/typedoc-dark-theme/bin/default/ src && echo \"Docs generated at ./docs/index.html\"",
		"prepublishOnly": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/carriejv/fflogs-client.git"
	},
	"bugs": {
		"url": "https://github.com/carriejv/fflogs-client/issues"
	},
	"homepage": "https://github.com/carriejv/fflogs-client",
	"author": "Carrie J V <carrie@carriejv.com>",
	"contributors": [
		"carrie@carriejv.com <carrie@carriejv.com>"
	],
	"license": "Apache-2.0",
	"private": false,
	"dependencies": {
		"@apollo/client": "^4.1.9",
		"axios": "^1.16.1",
		"graphql": "^16.14.0",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@types/axios": "^0.9.36",
		"@types/chai": "^5.2.3",
		"@types/follow-redirects": "^1.14.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.8.0",
		"@types/sinon": "^21.0.1",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"chai": "^6.2.2",
		"eslint": "^10.4.0",
		"mocha": "^11.3.0",
		"nyc": "^18.0.0",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.19",
		"typedoc-dark-theme": "0.0.11",
		"typescript": "^6.0.3"
	}
}
